# Copy to .env. No secrets are required: FMI open data needs no API key.

# Internal research explorer (charts, date scrubbing, raw JSON).
# true ONLY on the LAN-only deployment. Never in production.
ENABLE_CHARTS=false

# Public weather page — what the watch shows, live. true in production.
ENABLE_PUBLIC=false

# Shipped app defaults (RESEARCH.md §16)
DEFAULT_PLACE=Helsinki
DEFAULT_SEA_FMISID=100996

# Cache TTLs in seconds — keep FMI requests well inside fair use.
TTL_FORECAST=900
TTL_OBSERVATIONS=300
TTL_MARINE=600
