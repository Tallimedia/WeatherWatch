# Copy to .env. No secrets are required: FMI open data needs no API key.

# Prototype data-graphics site. true ONLY on the internal deployment
# (weather.int.kavaleff.com). Leave false/unset in production.
ENABLE_CHARTS=false

# Shipped app defaults (RESEARCH.md §16)
DEFAULT_PLACE=Helsinki
DEFAULT_SEA_FMISID=100996

# Cache TTLs in seconds — keep FMI requests well inside fair use.
TTL_FORECAST=900
TTL_OBSERVATIONS=300
TTL_MARINE=600
